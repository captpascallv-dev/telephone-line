<Window x:Class="PascalCockpit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PascalCockpit.Views;assembly=PascalCockpit.Views"
        Title="Pascal Cockpit"
        Language="zh-CN"
        Width="248" Height="360"
        MinWidth="200" MinHeight="200"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Background="{StaticResource HudBackground}"
        Foreground="{StaticResource HudText}"
        FontFamily="{StaticResource HudFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{StaticResource HudPanel}" BorderBrush="{StaticResource HudLine}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Pascal Cockpit" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <Button x:Name="LangZhButton" Style="{StaticResource ChromeButton}" Content="中文" Click="OnLangZhClick" Margin="10,0,0,0" AutomationProperties.AutomationId="LangZhButton" AutomationProperties.Name="中文" ToolTip="中文"/>
          <Button x:Name="LangEnButton" Style="{StaticResource ChromeButton}" Content="English" Click="OnLangEnClick" AutomationProperties.AutomationId="LangEnButton" AutomationProperties.Name="English" ToolTip="English"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="RefreshButton" Style="{StaticResource ChromeButton}" Content="刷新" Click="OnRefreshClick" ToolTip="后台刷新，不抢焦点" AutomationProperties.AutomationId="RefreshButton"/>
          <Button x:Name="CopyHelpButton" Style="{StaticResource ChromeButton}" Content="复制摘要" Click="OnCopyHelpClick" ToolTip="复制求助摘要，不外发" AutomationProperties.AutomationId="CopyHelpButton"/>
          <Button x:Name="TopmostButton" Style="{StaticResource ChromeButton}" Content="置顶" Click="OnTopmostClick" AutomationProperties.AutomationId="TopmostButton"/>
          <Button x:Name="CollapseButton" Style="{StaticResource ChromeButton}" Content="展开" Click="OnCollapseClick" AutomationProperties.AutomationId="CollapseButton"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="{StaticResource HudPanel}" BorderBrush="{StaticResource HudLine}" BorderThickness="0,1,0,0" Padding="10,6">
      <StackPanel>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource HudMuted}" TextWrapping="Wrap" Text="等待首次刷新。" AutomationProperties.AutomationId="StatusText"/>
        <TextBlock x:Name="NavMessageText" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <Button x:Name="CopyIdButton" Style="{StaticResource ChromeButton}" Content="复制目标 ID" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" Click="OnCopyIdClick"/>
      </StackPanel>
    </Border>
    <Grid Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource HudPanel}" BorderBrush="{StaticResource HudLine}" BorderThickness="1" CornerRadius="8" Padding="4">
        <Grid>
          <views:HudView x:Name="Hud"/>
          <TextBlock x:Name="HudFallback" Visibility="Collapsed" TextWrapping="Wrap" Margin="8" Foreground="{StaticResource HudMuted}"/>
        </Grid>
      </Border>
      <Border x:Name="DetailsHost" Grid.Column="1" Margin="8,0,0,0" Background="{StaticResource HudPanel}" BorderBrush="{StaticResource HudLine}" BorderThickness="1" CornerRadius="8" Padding="4" Visibility="Collapsed" AutomationProperties.AutomationId="DetailsHost" AutomationProperties.Name="详情">
        <Grid>
          <views:DetailsView x:Name="Details"/>
          <TextBlock x:Name="DetailsFallback" Visibility="Collapsed" TextWrapping="Wrap" Margin="8" Foreground="{StaticResource HudMuted}"/>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
