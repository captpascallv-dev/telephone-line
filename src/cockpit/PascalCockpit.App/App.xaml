<Application x:Class="PascalCockpit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup"
             Exit="OnExit"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Color x:Key="HudCanvasColor">#FFFBFCFA</Color>
    <Color x:Key="HudPanelColor">#FFFFFFFF</Color>
    <Color x:Key="HudLineColor">#FFDCE4DE</Color>
    <Color x:Key="HudTextColor">#FF202824</Color>
    <Color x:Key="HudMutedColor">#FF53625A</Color>
    <Color x:Key="HudMintColor">#FF146C4B</Color>
    <SolidColorBrush x:Key="HudBackground" Color="{StaticResource HudCanvasColor}"/>
    <SolidColorBrush x:Key="HudPanel" Color="{StaticResource HudPanelColor}"/>
    <SolidColorBrush x:Key="HudLine" Color="{StaticResource HudLineColor}"/>
    <SolidColorBrush x:Key="HudText" Color="{StaticResource HudTextColor}"/>
    <SolidColorBrush x:Key="HudMuted" Color="{StaticResource HudMutedColor}"/>
    <SolidColorBrush x:Key="HudMint" Color="{StaticResource HudMintColor}"/>
    <SolidColorBrush x:Key="HudHover" Color="#FFF0F4F0"/>
    <SolidColorBrush x:Key="HudSelected" Color="#FFEAF3ED"/>
    <FontFamily x:Key="HudFont">Microsoft YaHei UI</FontFamily>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HudText}"/>
      <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="56"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Foreground" Value="{StaticResource HudText}"/>
      <Setter Property="Background" Value="{StaticResource HudPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HudLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource HudFont}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Application.Resources>
</Application>
