{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:codex-app-server-lead-status-sources:v1",
  "title": "telephone-line-codex-app-server-lead-status-sources-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "sources"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-codex-app-server-lead-status-sources-v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "root"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "kind": {
            "type": "string",
            "const": "codex-app-server-lead-runs"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32767,
            "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
          }
        }
      }
    }
  }
}
