{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:control-plane-wave-manifest:v1",
  "title": "telephone-line-control-plane-wave-manifest-v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "project", "project_epoch", "goal_summary", "authority", "lead", "wave_id", "batch_id", "batch_n", "control_state_root", "supervisor_state_root", "install_root", "activation_generation", "projection_stale_after_seconds", "lanes", "actions", "next_transition", "source_spec", "generated_at_utc"],
  "properties": {
    "protocol_version": { "const": "telephone-line-control-plane-wave-manifest-v1" },
    "project": { "$ref": "#/$defs/label" }, "project_epoch": { "$ref": "#/$defs/label" }, "goal_summary": { "$ref": "#/$defs/label" }, "authority": { "$ref": "#/$defs/identity" }, "lead": { "$ref": "#/$defs/lead" },
    "wave_id": { "$ref": "#/$defs/label" }, "batch_id": { "$ref": "#/$defs/uuid" }, "batch_n": { "type": "integer", "minimum": 1, "maximum": 32 },
    "control_state_root": { "$ref": "#/$defs/path" }, "supervisor_state_root": { "$ref": "#/$defs/path" }, "install_root": { "$ref": "#/$defs/path" }, "activation_generation": { "$ref": "#/$defs/sha" }, "projection_stale_after_seconds": { "type": "integer", "minimum": 5, "maximum": 86400 },
    "lanes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/lane" } }, "actions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/action" } },
    "next_transition": { "$ref": "#/$defs/next" }, "source_spec": { "$ref": "#/$defs/identity" }, "generated_at_utc": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001F]+$" }, "path": { "type": "string", "minLength": 1, "maxLength": 32767, "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "nullable_label": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/label" }] }, "nullable_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] },
    "lead": { "type": "object", "additionalProperties": false, "required": ["transport", "session_id", "run_id"], "properties": { "transport": { "enum": ["wired", "wireless"] }, "session_id": { "$ref": "#/$defs/label" }, "run_id": { "$ref": "#/$defs/label" }, "owner_file": { "$ref": "#/$defs/path" } } },
    "command": { "type": "object", "additionalProperties": false, "required": ["executable", "working_directory", "arguments"], "properties": { "executable": { "$ref": "#/$defs/path" }, "working_directory": { "$ref": "#/$defs/path" }, "arguments": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 32767 } } } },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["package_id", "role", "route", "line_job_id", "request", "telephone_state_root", "workspace", "card", "card_characters", "allowed_write_paths", "write_lease_id", "launch_grace_seconds", "callback_grace_seconds", "starter_command", "launch_owner"],
      "properties": {
        "package_id": { "$ref": "#/$defs/label" }, "role": { "enum": ["execution", "review"] }, "route": { "$ref": "#/$defs/label" }, "line_job_id": { "$ref": "#/$defs/uuid" },
        "request": { "$ref": "#/$defs/identity" }, "telephone_state_root": { "$ref": "#/$defs/path" }, "workspace": { "$ref": "#/$defs/path" }, "card": { "$ref": "#/$defs/identity" }, "card_characters": { "type": "integer", "minimum": 1, "maximum": 12000 },
        "allowed_write_paths": { "type": "array", "maxItems": 128, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } }, "write_lease_id": { "$ref": "#/$defs/sha" },
        "launch_grace_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }, "callback_grace_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }, "starter_command": { "$ref": "#/$defs/command" },
        "launch_owner": { "oneOf": [
          { "type":"object","additionalProperties":false,"required":["kind","state_root","run_id","request","request_sha256"],"properties":{"kind":{"const":"wired_supervisor"},"state_root":{"$ref":"#/$defs/path"},"run_id":{"$ref":"#/$defs/uuid"},"request":{"$ref":"#/$defs/identity"},"request_sha256":{"$ref":"#/$defs/sha"}} },
          { "type":"object","additionalProperties":false,"required":["kind","starter_sha256"],"properties":{"kind":{"const":"wireless_app_server"},"starter_sha256":{"$ref":"#/$defs/sha"}} }
        ] }
      }
    },
    "trigger": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["always", "all_lanes_delivered", "all_lanes_terminal", "lane_failed", "file_exists", "file_text_equals", "json_true"] }, "path": { "$ref": "#/$defs/path" }, "expected_text": { "type": "string", "maxLength": 4096 }, "json_property": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" }, "target_package_id": { "$ref": "#/$defs/label" } } },
    "postcondition": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["exit_zero", "file_exists", "file_text_equals", "json_true", "current_wave", "lane_job_exists", "supervisor_request_published"] }, "path": { "$ref": "#/$defs/path" }, "expected_text": { "type": "string", "maxLength": 4096 }, "json_property": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" }, "project_epoch": { "$ref": "#/$defs/label" }, "wave_id": { "$ref": "#/$defs/label" }, "telephone_state_root": { "$ref": "#/$defs/path" }, "line_job_id": { "$ref": "#/$defs/uuid" }, "state_root": { "$ref": "#/$defs/path" }, "run_id": { "$ref": "#/$defs/uuid" }, "request_sha256": { "$ref": "#/$defs/sha" } } },
    "replacement": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["package_id", "line_job_id", "retry_of_line_job_id", "attempt", "request", "starter_command", "telephone_state_root", "workspace", "write_lease_id"], "properties": { "package_id": { "$ref": "#/$defs/label" }, "line_job_id": { "$ref": "#/$defs/uuid" }, "retry_of_line_job_id": { "$ref": "#/$defs/uuid" }, "attempt": { "type": "integer", "minimum": 2, "maximum": 16 }, "request": { "$ref": "#/$defs/identity" }, "starter_command": { "$ref": "#/$defs/command" }, "telephone_state_root": { "$ref": "#/$defs/path" }, "workspace": { "$ref": "#/$defs/path" }, "write_lease_id": { "$ref": "#/$defs/sha" } } }] },
    "contract": { "type": "object", "additionalProperties": false, "required": ["project", "project_epoch", "wave_id", "batch_id", "authority", "source_spec", "lead", "command_sha256", "expected_postcondition", "target_package_id", "target_line_job_id", "target_workspace", "target_write_lease_id", "replacement", "retry_policy", "contract_fingerprint"], "properties": { "project": { "$ref": "#/$defs/label" }, "project_epoch": { "$ref": "#/$defs/label" }, "wave_id": { "$ref": "#/$defs/label" }, "batch_id": { "$ref": "#/$defs/uuid" }, "authority": { "$ref": "#/$defs/identity" }, "source_spec": { "$ref": "#/$defs/identity" }, "lead": { "$ref": "#/$defs/lead" }, "command_sha256": { "$ref": "#/$defs/sha" }, "expected_postcondition": { "$ref": "#/$defs/postcondition" }, "target_package_id": { "$ref": "#/$defs/nullable_label" }, "target_line_job_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] }, "target_workspace": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/path" }] }, "target_write_lease_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] }, "replacement": { "$ref": "#/$defs/replacement" }, "retry_policy": { "enum": ["conflict_if_ambiguous", "safe_once_if_no_effect"] }, "contract_fingerprint": { "$ref": "#/$defs/sha" } } },
    "action": { "type": "object", "additionalProperties": false, "required": ["action_id", "kind", "sequence", "depends_on", "idempotency_key", "trigger", "command", "contract"], "properties": { "action_id": { "$ref": "#/$defs/label" }, "kind": { "enum": ["admission", "second_turn", "lane_recovery", "next_wave", "custom_authorized"] }, "sequence": { "type": "integer", "minimum": 1 }, "depends_on": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/label" } }, "idempotency_key": { "$ref": "#/$defs/label" }, "trigger": { "$ref": "#/$defs/trigger" }, "command": { "$ref": "#/$defs/command" }, "contract": { "$ref": "#/$defs/contract" } } },
    "next": { "type": "object", "additionalProperties": false, "required": ["transition_id", "kind", "authorized", "idempotency_key"], "properties": { "transition_id": { "$ref": "#/$defs/label" }, "kind": { "$ref": "#/$defs/label" }, "authorized": { "type": "boolean" }, "idempotency_key": { "$ref": "#/$defs/label" } } }
  }
}
