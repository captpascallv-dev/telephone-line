{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:wired-supervisor-owner:v1",
  "title": "telephone-line-wired-supervisor-owner-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "kind",
    "pid",
    "start_time_utc_ticks",
    "started_at_utc"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-wired-supervisor-owner-v1"
    },
    "kind": {
      "type": "string",
      "enum": ["supervisor", "run"]
    },
    "run_id": {
      "$ref": "#/$defs/uuid"
    },
    "request_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "start_time_utc_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "started_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "lead_pid": {
      "type": "integer",
      "minimum": 1
    },
    "lead_start_time_utc_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "lead_started_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "job_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._\\\\:-]+$"
    },
    "project": {
      "$ref": "#/$defs/opaque_label"
    },
    "stage": {
      "$ref": "#/$defs/opaque_label"
    },
    "lead_session_id": {
      "$ref": "#/$defs/session_id"
    },
    "lead_run_id": {
      "$ref": "#/$defs/session_id"
    },
    "installed_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "source_sha256"
      ],
      "properties": {
        "version_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "opaque_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
