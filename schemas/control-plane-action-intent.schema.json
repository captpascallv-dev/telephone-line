{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:telephone-line:schema:control-plane-action-intent:v1", "title": "telephone-line-control-plane-action-intent-v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "action_id", "kind", "idempotency_key", "manifest", "contract_fingerprint", "command_sha256", "state_before", "expected_postcondition", "retry_policy", "created_at_utc"],
  "properties": {
    "protocol_version": { "const": "telephone-line-control-plane-action-intent-v1" }, "action_id": { "$ref": "#/$defs/label" }, "kind": { "$ref": "#/$defs/label" }, "idempotency_key": { "$ref": "#/$defs/label" },
    "manifest": { "$ref": "#/$defs/identity" }, "contract_fingerprint": { "$ref": "#/$defs/sha" }, "command_sha256": { "$ref": "#/$defs/sha" }, "state_before": { "$ref": "#/$defs/identity" },
    "expected_postcondition": { "type": "object" }, "retry_policy": { "enum": ["conflict_if_ambiguous", "safe_once_if_no_effect"] }, "created_at_utc": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 2000 }, "path": { "type": "string", "minLength": 1, "maxLength": 32767 }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } } }
  }
}
