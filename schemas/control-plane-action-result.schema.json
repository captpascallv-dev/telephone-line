{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:telephone-line:schema:control-plane-action-result:v1", "title": "telephone-line-control-plane-action-result-v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "action_id", "idempotency_key", "kind", "manifest", "contract_fingerprint", "command_sha256", "intent", "status", "exit_code", "started_at_utc", "completed_at_utc", "stdout", "stderr", "state_before", "state_after", "recovered_after_crash", "retry_count", "preserved_lane_fingerprints"],
  "properties": {
    "protocol_version": { "const": "telephone-line-control-plane-action-result-v1" }, "action_id": { "$ref": "#/$defs/label" }, "idempotency_key": { "$ref": "#/$defs/label" }, "kind": { "$ref": "#/$defs/label" },
    "manifest": { "$ref": "#/$defs/identity" }, "contract_fingerprint": { "$ref": "#/$defs/sha" }, "command_sha256": { "$ref": "#/$defs/sha" }, "intent": { "$ref": "#/$defs/identity" },
    "status": { "enum": ["completed", "failed", "planned", "skipped", "conflict"] }, "exit_code": { "type": "integer" }, "started_at_utc": { "$ref": "#/$defs/time" }, "completed_at_utc": { "$ref": "#/$defs/time" },
    "stdout": { "$ref": "#/$defs/identity" }, "stderr": { "$ref": "#/$defs/identity" }, "state_before": { "$ref": "#/$defs/identity" }, "state_after": { "$ref": "#/$defs/identity" },
    "recovered_after_crash": { "type": "boolean" }, "retry_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "preserved_lane_fingerprints": { "type": "object" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 2000 }, "path": { "type": "string", "minLength": 1, "maxLength": 32767 }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } } }
  }
}
