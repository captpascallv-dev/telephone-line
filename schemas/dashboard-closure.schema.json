{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:dashboard-closure:v1",
  "title": "telephone-line-dashboard-closure-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "project",
    "lead_session_id",
    "receipt",
    "closed_at_utc"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-dashboard-closure-v1"
    },
    "project": {
      "$ref": "#/$defs/opaque_label"
    },
    "lead_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "lead_run_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]*$"
    },
    "receipt": {
      "$ref": "#/$defs/file_identity"
    },
    "closed_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    }
  },
  "$defs": {
    "opaque_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "windows_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/windows_path" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
