{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:receipt:v1",
  "title": "telephone-line-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "line_job_id",
    "project",
    "stage",
    "role",
    "route",
    "summary",
    "dispatch",
    "transport_complete",
    "command_exit_code",
    "command_error_code",
    "command_error_message",
    "stdout",
    "stderr",
    "started_at_utc",
    "completed_at_utc",
    "absolute_task_timeout",
    "automatic_rerun",
    "project_judgment"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-receipt-v1"
    },
    "line_job_id": {
      "$ref": "#/$defs/uuid"
    },
    "project": {
      "$ref": "#/$defs/opaque_label"
    },
    "stage": {
      "$ref": "#/$defs/opaque_label"
    },
    "role": {
      "type": "string",
      "enum": ["execution", "review"]
    },
    "route": {
      "$ref": "#/$defs/opaque_label"
    },
    "summary": {
      "$ref": "#/$defs/opaque_label"
    },
    "dispatch": {
      "$ref": "#/$defs/file_identity"
    },
    "transport_complete": {
      "type": "boolean"
    },
    "command_exit_code": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_error_code": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "command_error_message": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/file_identity"
        }
      ]
    },
    "stderr": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/file_identity"
        }
      ]
    },
    "started_at_utc": {
      "oneOf": [
        {
          "$ref": "#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "completed_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "absolute_task_timeout": {
      "type": "boolean",
      "const": false
    },
    "automatic_rerun": {
      "type": "boolean",
      "const": false
    },
    "project_judgment": {
      "type": "boolean",
      "const": false
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "windows_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
    },
    "opaque_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/windows_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
