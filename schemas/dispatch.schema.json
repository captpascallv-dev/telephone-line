{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:dispatch:v1",
  "title": "telephone-line-dispatch-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "line_job_id",
    "project",
    "stage",
    "role",
    "route",
    "summary",
    "lead",
    "command",
    "source_request",
    "lead_binding",
    "created_at_utc",
    "absolute_task_timeout",
    "project_judgment"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-dispatch-v1"
    },
    "line_job_id": {
      "$ref": "#/$defs/uuid"
    },
    "project": {
      "$ref": "#/$defs/opaque_label"
    },
    "stage": {
      "$ref": "#/$defs/opaque_label"
    },
    "role": {
      "type": "string",
      "enum": ["execution", "review"]
    },
    "route": {
      "$ref": "#/$defs/opaque_label"
    },
    "summary": {
      "$ref": "#/$defs/opaque_label"
    },
    "lead": {
      "$ref": "#/$defs/lead_binding"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "working_directory",
        "arguments",
        "stdin"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/windows_path"
        },
        "working_directory": {
          "$ref": "#/$defs/windows_path"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/file_identity"
            }
          ]
        }
      }
    },
    "source_request": {
      "$ref": "#/$defs/file_identity"
    },
    "lead_binding": {
      "$ref": "#/$defs/file_identity"
    },
    "created_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "absolute_task_timeout": {
      "type": "boolean",
      "const": false
    },
    "project_judgment": {
      "type": "boolean",
      "const": false
    },
    "nested_target": {
      "$ref": "#/$defs/lead_binding"
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "batch_id",
        "package_id",
        "package_ids",
        "n"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "const": "telephone-line-batch-v1"
        },
        "batch_id": {
          "$ref": "#/$defs/uuid"
        },
        "package_id": {
          "$ref": "#/$defs/opaque_label"
        },
        "package_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/opaque_label"
          }
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "retry_of": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuid"
            }
          ]
        },
        "implicit": {
          "type": "boolean"
        }
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "project", "project_epoch", "wave_id", "control_state_root", "supervisor_state_root", "install_root", "manifest_path", "source_spec", "authority", "activation_generation", "lead_run_id", "package_id", "batch_id", "attempt", "route", "workspace", "write_lease_id"],
      "properties": {
        "protocol_version": { "const": "telephone-line-control-plane-job-binding-v1" },
        "project": { "$ref": "#/$defs/opaque_label" },
        "project_epoch": { "$ref": "#/$defs/opaque_label" },
        "wave_id": { "$ref": "#/$defs/opaque_label" },
        "control_state_root": { "$ref": "#/$defs/windows_path" },
        "supervisor_state_root": { "$ref": "#/$defs/windows_path" },
        "install_root": { "$ref": "#/$defs/windows_path" },
        "manifest_path": { "$ref": "#/$defs/windows_path" },
        "source_spec": { "$ref": "#/$defs/file_identity" },
        "authority": { "$ref": "#/$defs/file_identity" },
        "activation_generation": { "$ref": "#/$defs/sha256" },
        "lead_run_id": { "$ref": "#/$defs/opaque_label" },
        "package_id": { "$ref": "#/$defs/opaque_label" },
        "batch_id": { "$ref": "#/$defs/uuid" },
        "attempt": { "type": "integer", "minimum": 1 },
        "route": { "$ref": "#/$defs/opaque_label" },
        "workspace": { "$ref": "#/$defs/windows_path" },
        "write_lease_id": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "windows_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
    },
    "opaque_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F]+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/windows_path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lead_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "session_id",
        "worktree",
        "launcher"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "const": "telephone-line-lead-binding-v1"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "worktree": {
          "$ref": "#/$defs/windows_path"
        },
        "launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "arguments"],
          "properties": {
            "path": {
              "$ref": "#/$defs/windows_path"
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
