{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:control-plane-current-state:v1",
  "title": "telephone-line-control-plane-current-state-v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol_version", "projection_version", "projection_fingerprint", "project", "project_epoch", "goal_summary", "authority", "manifest", "current_pointer", "activation_generation", "lead", "wave_id", "batch_id", "batch_n", "dashboard_phase", "overall_state", "lanes", "actions", "completed_count", "failed_count", "in_flight_count", "last_transition", "next_transition", "requires_pascal", "terminal", "projection_status", "findings", "continuation_capsule", "history_index", "stale_after_seconds", "updated_at_utc"],
  "properties": {
    "protocol_version": { "const": "telephone-line-control-plane-current-state-v1" }, "projection_version": { "type": "integer", "minimum": 1 }, "projection_fingerprint": { "$ref": "#/$defs/sha" },
    "project": { "$ref": "#/$defs/label" }, "project_epoch": { "$ref": "#/$defs/label" }, "goal_summary": { "$ref": "#/$defs/label" }, "authority": { "$ref": "#/$defs/identity" }, "manifest": { "$ref": "#/$defs/identity" }, "current_pointer": { "$ref": "#/$defs/identity" }, "activation_generation": { "$ref": "#/$defs/sha" }, "lead": { "$ref": "#/$defs/lead" },
    "wave_id": { "$ref": "#/$defs/label" }, "batch_id": { "$ref": "#/$defs/uuid" }, "batch_n": { "type": "integer", "minimum": 1, "maximum": 32 },
    "dashboard_phase": { "enum": ["idle", "lead", "execute", "review", "sync", "modify", "closure", "closed"] }, "overall_state": { "enum": ["declared", "starting", "executing", "awaiting_callback", "accepting", "failed", "unknown", "terminal"] },
    "lanes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/lane" } },
    "actions": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/action_state" } },
    "completed_count": { "type": "integer", "minimum": 0 }, "failed_count": { "type": "integer", "minimum": 0 }, "in_flight_count": { "type": "integer", "minimum": 0 },
    "last_transition": { "$ref": "#/$defs/transition" }, "next_transition": { "$ref": "#/$defs/next" }, "requires_pascal": { "type": "boolean" }, "terminal": { "type": "boolean" },
    "projection_status": { "enum": ["healthy", "unknown", "conflict"] }, "findings": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "continuation_capsule": { "$ref": "#/$defs/identity" }, "history_index": { "$ref": "#/$defs/identity" }, "stale_after_seconds": { "type": "integer", "minimum": 5, "maximum": 86400 }, "updated_at_utc": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "label": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001F]+$" }, "path": { "type": "string", "minLength": 1, "maxLength": 32767, "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$" }, "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "identity": { "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "nullable_identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] }, "nullable_uuid": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
    "owner": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["pid", "start_time_utc_ticks", "alive"], "properties": { "pid": { "type": "integer", "minimum": 1 }, "start_time_utc_ticks": { "type": "integer", "minimum": 1 }, "alive": { "type": "boolean" } } }] },
    "lead": { "type": "object", "additionalProperties": false, "required": ["transport", "session_id", "run_id", "owner"], "properties": { "transport": { "enum": ["wired", "wireless"] }, "session_id": { "$ref": "#/$defs/label" }, "run_id": { "$ref": "#/$defs/label" }, "owner": { "$ref": "#/$defs/owner" } } },
    "lane": { "type": "object", "additionalProperties": false, "required": ["package_id", "role", "route", "original_line_job_id", "line_job_id", "attempt", "retry_of_line_job_id", "state", "failure_class", "diagnostic_code", "owner", "receipt", "delivery", "relay_error", "shared_host_evidence", "callback_active", "last_evidence_at_utc", "evidence_age_seconds", "launch_grace_seconds", "callback_grace_seconds", "request", "card", "workspace", "allowed_write_paths", "write_lease_id", "evidence_fingerprint"], "properties": {
      "package_id": { "$ref": "#/$defs/label" }, "role": { "enum": ["execution", "review"] }, "route": { "$ref": "#/$defs/label" }, "original_line_job_id": { "$ref": "#/$defs/uuid" }, "line_job_id": { "$ref": "#/$defs/uuid" }, "attempt": { "type": "integer", "minimum": 1 }, "retry_of_line_job_id": { "$ref": "#/$defs/nullable_uuid" },
      "state": { "enum": ["declared", "starting", "executing", "receipt_ready", "callback_running", "delivered", "handled", "failed", "unknown"] }, "failure_class": { "enum": ["none", "telephone_transport", "executor_session", "shared_host", "state_conflict"] }, "diagnostic_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "owner": { "$ref": "#/$defs/owner" }, "receipt": { "$ref": "#/$defs/nullable_identity" }, "delivery": { "$ref": "#/$defs/nullable_identity" }, "relay_error": { "$ref": "#/$defs/nullable_identity" }, "shared_host_evidence": { "$ref": "#/$defs/nullable_identity" },
      "callback_active": { "type": "boolean" }, "last_evidence_at_utc": { "$ref": "#/$defs/time" }, "evidence_age_seconds": { "type": "integer", "minimum": 0 }, "launch_grace_seconds": { "type": "integer", "minimum": 0 }, "callback_grace_seconds": { "type": "integer", "minimum": 0 },
      "request": { "$ref": "#/$defs/identity" }, "card": { "$ref": "#/$defs/identity" }, "workspace": { "$ref": "#/$defs/path" }, "allowed_write_paths": { "type": "array", "maxItems": 128, "items": { "type": "string" } }, "write_lease_id": { "$ref": "#/$defs/sha" }, "evidence_fingerprint": { "$ref": "#/$defs/sha" }
    } },
    "action_state": { "type": "object", "additionalProperties": false, "required": ["action_id", "kind", "sequence", "idempotency_key", "state", "reason", "retry_count", "result"], "properties": { "action_id": { "$ref": "#/$defs/label" }, "kind": { "$ref": "#/$defs/label" }, "sequence": { "type": "integer", "minimum": 1 }, "idempotency_key": { "$ref": "#/$defs/label" }, "state": { "enum": ["pending", "running", "completed", "retryable_failed", "blocked", "conflict", "exhausted"] }, "reason": { "$ref": "#/$defs/label" }, "retry_count": { "type": "integer", "minimum": 0, "maximum": 1 }, "result": { "$ref": "#/$defs/nullable_identity" } } },
    "transition": { "type": "object", "additionalProperties": false, "required": ["protocol_version", "event_id", "project", "project_epoch", "wave_id", "projection_version", "projection_fingerprint", "kind", "idempotency_key", "at_utc", "transition"], "properties": { "protocol_version": { "const": "telephone-line-control-plane-event-v1" }, "event_id": { "$ref": "#/$defs/sha" }, "project": { "$ref": "#/$defs/label" }, "project_epoch": { "$ref": "#/$defs/label" }, "wave_id": { "$ref": "#/$defs/label" }, "projection_version": { "type": "integer", "minimum": 1 }, "projection_fingerprint": { "$ref": "#/$defs/sha" }, "kind": { "$ref": "#/$defs/label" }, "idempotency_key": { "$ref": "#/$defs/label" }, "at_utc": { "$ref": "#/$defs/time" }, "transition": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] } } },
    "next": { "type": "object", "additionalProperties": false, "required": ["transition_id", "kind", "authorized", "idempotency_key"], "properties": { "transition_id": { "$ref": "#/$defs/label" }, "kind": { "$ref": "#/$defs/label" }, "authorized": { "type": "boolean" }, "idempotency_key": { "$ref": "#/$defs/label" } } }
  }
}
