{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:lifecycle-status:v1",
  "title": "telephone-line-lifecycle-status-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "line_job_id",
    "phase",
    "idle",
    "automatic_rerun",
    "replacement_started",
    "updated_at_utc"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-lifecycle-status-v1"
    },
    "line_job_id": {
      "type": "string",
      "minLength": 0,
      "maxLength": 64,
      "pattern": "^$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "phase": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "idle": {
      "type": "boolean"
    },
    "automatic_rerun": {
      "type": "boolean",
      "const": false
    },
    "replacement_started": {
      "type": "boolean",
      "const": false
    },
    "updated_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
