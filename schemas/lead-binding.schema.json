{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:lead-binding:v1",
  "title": "telephone-line-lead-binding-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "session_id",
    "worktree",
    "launcher"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-lead-binding-v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "arguments"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "pattern": "^[^\\u0000-\\u001F\"<>|*?]+$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
