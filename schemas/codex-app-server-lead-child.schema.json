{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:codex-app-server-lead-child:v1",
  "title": "telephone-line-codex-app-server-lead-child-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "pid",
    "start_time_utc_ticks",
    "started_at_utc"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-codex-app-server-lead-child-v1"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "start_time_utc_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001F]+$"
    }
  }
}
