{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telephone-line:schema:release-manifest:v1",
  "title": "telephone-line-release-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "product",
    "version",
    "license",
    "platform",
    "denominator",
    "route_ids",
    "artifacts",
    "files",
    "counts",
    "excluded"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "const": "telephone-line-release-manifest-v1"
    },
    "product": {
      "type": "string",
      "const": "telephone-line"
    },
    "version": {
      "type": "string",
      "const": "0.1.0"
    },
    "license": {
      "type": "string",
      "const": "MPL-2.0"
    },
    "platform": {
      "type": "string",
      "const": "windows"
    },
    "denominator": {
      "type": "integer",
      "const": 8
    },
    "route_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "contains",
          "bytes",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+\\.zip$"
          },
          "contains": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001F]+$"
          },
          "bytes": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "excluded": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u001F]+$"
      }
    }
  }
}
